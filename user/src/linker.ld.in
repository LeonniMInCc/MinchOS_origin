/* 用户程序链接脚本【模板】
 *
 * 这是一个模板，%APP_BASE% 由 tools/build-user.py 在编译每个程序前替换。
 * 生成的 linker.ld 不进版本库。
 *
 * 为什么每个程序要用不同的基址？因为本章没有分页 —— 所有程序同时躺在
 * 同一片物理内存里，各自占一个 128 KiB 的槽位：
 *
 *     程序 0 → 0x80400000
 *     程序 1 → 0x80420000
 *     程序 2 → 0x80440000
 *     ...
 *
 * 程序里的每一个绝对地址（函数地址、全局变量、字符串字面量）在链接时
 * 就被写死了，所以一个链接到 0x80400000 的程序放到 0x80420000 上运行，
 * 会立刻跳到错误的地方。这就是"没有分页"的代价。
 *
 * 第 7 周引入分页后，这个地址会变成**虚拟地址**，所有程序都可以
 * 以为自己独占 0x80400000，而实际占用互不相同的物理页。
 * 那时这个模板就可以退休了。
 */

OUTPUT_ARCH(riscv)
ENTRY(_start)

BASE_ADDRESS = %APP_BASE%;

SECTIONS
{
    . = BASE_ADDRESS;

    .text : {
        /* 入口必须是程序的第一条指令：内核直接跳到 BASE_ADDRESS */
        *(.text.entry)
        *(.text .text.*)
    }

    . = ALIGN(4K);
    .rodata : {
        *(.rodata .rodata.*)
        *(.srodata .srodata.*)
    }

    . = ALIGN(4K);
    .data : {
        *(.data .data.*)
        *(.sdata .sdata.*)
    }

    .bss : {
        start_bss = .;
        *(.bss .bss.*)
        *(.sbss .sbss.*)
        end_bss = .;
    }

    /* 用户程序不需要自带栈 —— 内核会在 sp 里放好 USER_STACK 的栈顶 */

    /DISCARD/ : {
        *(.eh_frame)
        *(.debug*)
    }
}
